{
    "general": {
        "sequential": true,
        "chunk_size": 32,
        "split_retain": true,
        "positive_factor": 1.0,
        "positive_ratio": 2,
        "retain_loss": "CE",
        "split": "train"
    },
    "training_args": {
        "per_device_train_batch_size": 1,
        "gradient_accumulation_steps": 4,
        "learning_rate": 1e-05,
        "num_epochs": 1,
        "gradient_checkpointing": true,
        "logging_steps": 1
    },
    "model_params": {
        "model_size": "1B",
        "torch_dtype": "float32",
        "apply_lora": true,
        "lora_r": 16,
        "lora_alpha": 64,
        "lora_dropout": 0.05,
        "target_modules": [
            "q_proj",
            "k_proj",
            "v_proj",
            "o_proj",
            "up_proj",
            "down_proj",
            "gate_proj"
        ],
        "train_last_k": false,
        "k": 0
    }
}